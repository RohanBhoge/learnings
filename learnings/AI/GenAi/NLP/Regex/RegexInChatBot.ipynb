    "\n",
    "patternEmail=r\"[a-zA-Z0-9.]*@[a-zA-Z0-9.]*\\.com\"\n",
    "matches = re.findall(patternNumber, chat1 + chat2 + chat3)\n",
    "matches = re.findall(patternEmail, chat1 + chat2 + chat3)\n",
    "print(matches)"
